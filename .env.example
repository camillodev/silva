# Silva .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.silva/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.silva/.env, then silva.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in silva.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
SILVA_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# SILVA_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# SILVA_STATE_DIR=~/.silva
# SILVA_CONFIG_PATH=~/.silva/silva.json
# SILVA_HOME=~

# Optional: import missing keys from your login shell profile.
# SILVA_LOAD_SHELL_ENV=1
# SILVA_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# SILVA_LIVE_OPENAI_KEY=sk-...
# SILVA_LIVE_ANTHROPIC_KEY=sk-ant-...
# SILVA_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# -----------------------------------------------------------------------------
# Supabase (required for production; local Postgres via docker-compose for dev)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# Silva tenant config (optional — alternative to ~/.silva/tenant.yaml)
# -----------------------------------------------------------------------------
# SILVA_TENANT_NAME=Acme Corp
# SILVA_TENANT_DESCRIPTION=We build products
# SILVA_TENANT_TEAM_INFO=Rafael (eng), Maria (product)
# SILVA_TENANT_LANG=en

# Silva model router overrides (JSON — optional, falls back to role defaults)
# SILVA_ROUTER_RULES={"overrides":{"main":{"provider":"anthropic-messages","model":"claude-sonnet-4-6"}}}

# -----------------------------------------------------------------------------
# Integration layer — Composio + Pipedream
# -----------------------------------------------------------------------------
# Composio: connects 100+ apps (Gmail, Notion, Linear, GitHub, Slack, etc.)
# Connect apps at https://app.composio.dev — then Silva can act on them.
COMPOSIO_API_KEY=

# Pipedream: bidirectional workflow automation
# - Outbound: Silva triggers Pipedream workflows
# - Inbound: Pipedream POSTs to Silva via /hooks/pipedream
PIPEDREAM_API_KEY=
PIPEDREAM_WEBHOOK_SECRET=

# Silva inbound hooks token (used by Pipedream and other webhook senders)
# Must match openclaw.json hooks.token / SILVA_HOOKS_TOKEN
SILVA_HOOKS_TOKEN=

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# SILVA_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# DEEPGRAM_API_KEY=...
